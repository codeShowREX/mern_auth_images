# Auto detect text files and perform LF normalization
* text=auto

# JS files should use LF
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf

# CSS files should use LF
*.css text eol=lf
*.scss text eol=lf

# HTML files should use LF
*.html text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Configs
.env* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.prettierrc text eol=lf
.eslintrc text eol=lf

# Binary files should be left untouched
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary 